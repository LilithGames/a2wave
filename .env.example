# Example environment variables for a Docker deployment
# Usage: cp .env.example .env, then fill in the required entries

# ========================
# Required
# ========================

# Auth secret — a random string of at least 32 characters.
# Leave this empty and one is generated for you: `pnpm dev` writes it into this file, and the
# Docker entrypoint persists it in the data volume so restarts keep existing sessions valid.
# Set it explicitly to control the value (`openssl rand -hex 32`); an explicit secret always
# takes precedence and is never overwritten.
#
# REQUIRED for multi-replica deployments, and it must be the SAME value on every replica: a
# generated secret is private to the instance that made it, so replicas would reject each
# other's tokens and could not read SSO settings the others encrypted. PostgreSQL is the
# multi-instance backend, so the container refuses to start rather than generate one when
# DATABASE_URL points at PostgreSQL.
AUTH_SECRET=

# Lifetime (in days) of browser cookies and API/CLI bearer tokens. Defaults to 1 day (24 hours).
# Existing deployments keep the old behaviour when this is unset; set 7, 30, etc. to extend it (range 1-365).
# Changes apply only to new logins / newly issued tokens; to revoke existing tokens immediately,
# combine with a logout, a password change, or a tokenVersion bump.
# AUTH_SESSION_TTL_DAYS=1

# ========================
# Optional
# ========================

# Host port the Docker deployment publishes on (defaults to 3502). This remaps the
# HOST side only — the container always listens on 3502, because the image's EXPOSE,
# PORT default and HEALTHCHECK all hardcode it, and remapping the container side
# would leave the healthcheck probing a closed port and mark the service unhealthy.
# Set this when 3502 is already taken on the host.
A2WAVE_HOST_PORT=3502

# Database backend. The scheme alone selects it — a postgres:// (or postgresql://) URL means
# PostgreSQL, anything else is treated as a SQLite file path. There is no separate driver switch.
#
# Left unset, the Docker deployment defaults to SQLite at /app/data/a2wave.db on a named volume.
# That is the supported default: one container, no external dependency.
#
# PostgreSQL >= 9.6 is EXPERIMENTAL and not yet recommended for production — no production soak
# time, and there is NO SQLite -> PostgreSQL data migration path, so switching starts from an
# empty database. To try it, uncomment the line below and start with:
#   docker compose --profile postgres up -d
# The hostname `postgres` is the compose service; its port is deliberately not published to the
# host. Change POSTGRES_PASSWORD (and the password in the URL) before using this outside a trial.
#
# Prefer passing it per command rather than uncommenting: this file is read by host processes too
# (pnpm run dev, pnpm db:migrate), and `postgres` does not resolve off the compose network, so an
# uncommented line breaks every local command. That also lets a containerised PostgreSQL and a
# local SQLite instance run side by side. See docs/agent/postgresql.md.
#   DATABASE_URL=postgres://a2wave:a2wave@postgres:5432/a2wave docker compose --profile postgres up -d
# DATABASE_URL=postgres://a2wave:a2wave@postgres:5432/a2wave
# DATABASE_POOL_MAX=10
# POSTGRES_USER=a2wave
# POSTGRES_PASSWORD=a2wave
# POSTGRES_DB=a2wave
# POSTGRES_VERSION=16-alpine

# Optional initial admin password (applied on first boot only; never overwrites an existing password).
# Left empty, the first person to reach the setup page claims the admin account — there is no
# token guarding it. Set this if you cannot accept that window; it initializes the admin during
# boot and closes it entirely.
ADMIN_PASSWORD=

# Frontend origin, only when it is served separately from the API (the dev two-port setup;
# defaults to http://localhost:3501). It authorizes cross-origin reads *and* cookie-authenticated
# writes, so a split deployment must name the address the browser actually uses. The Docker
# single-container deployment serves the frontend from the API itself — those requests are
# same-origin and always allowed, so leave this alone even if you change A2WAVE_HOST_PORT.
CORS_ORIGIN=

# Trust X-Forwarded-For only from these direct TCP peers. Leave disabled unless a reverse proxy
# is in front of a2wave. Addresses may be exact IPv4/IPv6 values or CIDRs, comma-separated.
# The proxy must overwrite X-Forwarded-For or append its peer address to a standards-compliant chain.
TRUSTED_PROXY=false
TRUSTED_PROXY_ADDRESSES=

# The externally reachable origin of this instance, e.g. https://a2wave.example.com
# (a pure origin — no path, no trailing slash).
# Only the "gateway signing" feature needs it: once set, you can use a URL-form issuer, and the
# gateway can fetch the public key itself from {issuer}/.well-known/jwks.json instead of you
# hand-delivering a JWKS file.
# Left empty, the issuer keeps the a2wave-<hex> form and behaviour is unchanged.
PUBLIC_URL=

# Explicitly control whether auth cookies carry Secure + the __Host- prefix.
# Inferred from NODE_ENV by default (production = true, otherwise false).
# When NODE_ENV=production but the frontend is reached over plain HTTP (an intranet deployment,
# or one without an HTTPS ingress), this MUST be set to false — otherwise the browser drops the
# Secure cookie and login redirects back to the login page forever.
# AUTH_COOKIE_SECURE=false

# Host → container mapping for Claude Code localSession credentials.
# Defaults to ${HOME}/.claude — the claude login state of the OS user running docker compose.
# If that user has already run `claude /login`, choosing "use local login state" in a2wave
# works with zero configuration.
#
# Override it explicitly in these cases:
#   - docker started via sudo / systemd ($HOME = /root, which almost certainly has no login)
#   - you want to use a different account's token
# Note: the path must be absolute.
# A2WAVE_CLAUDE_LOGIN_DIR=/home/youruser/.claude

# Other Providers keep localSession state in the a2wave-cli-home Docker named volume.
# Log in inside the container as the service user, for example:
#   docker compose exec -u appuser a2wave qodercli login
# For Pi, run `docker compose exec -u appuser a2wave pi`, then enter `/login`.
# Normal container replacement preserves it; docker compose down -v deletes it with the volume.

# Optional Pi config/auth directory inside the container. Leave blank to use
# /home/appuser/.pi/agent in the persisted a2wave-cli-home volume.
PI_CODING_AGENT_DIR=

# Runtime install directory for Provider CLIs. The image preinstalls no Agent CLI (the seven
# together weigh ~1.4GB, while a given deployment typically uses only one or two); an admin
# installs them on demand from the "Agent CLI" section in the web UI instead.
# Inside the image this is set to /home/appuser/.a2wave — part of the a2wave-cli-home persistent
# volume, so CLIs already installed survive an image upgrade and need no reinstall.
# Note: docker compose down -v deletes the volume along with them, requiring a reinstall.
# Usually there is no need to override this; set it only to install CLIs onto a different mounted
# volume (must be an absolute in-container path, writable by the service user).
# A2WAVE_CLI_INSTALL_ROOT=/home/appuser/.a2wave

# UID/GID used by the a2wave process in the container. docker-compose forwards these values;
# by default docker-entrypoint.sh infers them from the owner of the mounted
# /home/appuser/.claude directory so mode-600 bind-mounted files remain readable.
# Set them explicitly to disable adaptive inference (PUID/PGID style):
# A2WAVE_RUN_AS_UID=1000
# A2WAVE_RUN_AS_GID=1000

# Remote Agent import URLs may resolve only to public addresses by default. For a controlled
# enterprise-private export service, list its exact DNS hostname here (comma-separated; no scheme,
# port, path, wildcard, or IP literal), then restart the service. Each redirect is revalidated and
# the connection is pinned to the validated DNS answer. Loopback, link-local, and cloud metadata
# endpoints (including 169.254.169.254, 100.100.100.200, and fd00:ec2::254, plus mapped forms)
# remain blocked even for an exact trusted hostname.
# Example: TRUSTED_IMPORT_HOSTS=agent-exports.internal.example.com
TRUSTED_IMPORT_HOSTS=

# Provider Base URLs may resolve only to public addresses by default. For an enterprise gateway
# that uses private DNS, list its exact controlled hostname here (comma-separated; no scheme,
# port, path, or wildcard), then restart the service. Trust covers the hostname's HTTP(S) ports
# and paths, but loopback, link-local, cloud metadata (including 169.254.169.254,
# 100.100.100.200, and fd00:ec2::254), and other forbidden ranges remain blocked.
# Claude OAuth/server-session discovery trusts only its fixed api.anthropic.com request;
# user-configured Provider Base URLs on that hostname still require this allowlist.
# Example: TRUSTED_PROVIDER_HOSTS=llm-proxy.internal.example.com,trae.internal.example.com
TRUSTED_PROVIDER_HOSTS=

# Remote MCP targets resolve only to public addresses by default. To reach a controlled
# enterprise-private MCP service, list its exact DNS hostname here (comma-separated; no scheme,
# port, path, wildcard, or IP literal). Connections are pinned to validated DNS answers.
# Example: TRUSTED_MCP_HOSTS=mcp.internal.example.com
TRUSTED_MCP_HOSTS=
# Remote A2A routes allow ordinary private/CGNAT/ULA targets by default. When public-only mode is
# selected below, this exact-hostname list remains available for controlled private exceptions.
# Example: TRUSTED_A2A_ROUTE_HOSTS=agents.internal.example.com
TRUSTED_A2A_ROUTE_HOSTS=

# Remote A2A network policy. The default supports internal enterprise services while retaining
# HTTP(S)-only validation, per-hop DNS pinning, redirect checks, and hard blocks for loopback,
# link-local, cloud metadata, multicast, unspecified, and other reserved ranges. Set false to
# require public targets; TRUSTED_A2A_ROUTE_HOSTS supplies exact private-DNS exceptions.
ALLOW_PRIVATE_ROUTE_TARGETS=true

# ========================
# E2E tests
# ========================

# Admin password used when Playwright runs the e2e suite (defaults to E2eTest123@).
# scripts/e2e-dev-server.mjs injects this value as ADMIN_PASSWORD for its isolated API.
# Usage: source .env before running npx playwright test; see docs/agent/e2e.md.
E2E_ADMIN_PASSWORD=E2eTest123@

# ========================
# Ports (defaults 3501/3502; use 3503/3504 for a parallel worktree)
# ========================

# Web (Vite) port, defaults to 3501
WEB_PORT=
# API (Hono) port, defaults to 3502
PORT=

# ========================
# Docker Compose deployment (optional)
# ========================

# Host mount path for the SCM workspace, defaults to /data/workspace (Linux servers).
# When running docker compose on macOS, /data is not in the Docker Desktop File Sharing
# allowlist, so point this at a directory under /Users, e.g. /Users/<you>/a2wave-workspace
A2WAVE_WORKSPACE_DIR=

# Comma-separated absolute in-container roots allowed for custom SCM workspacesPath values.
# The native default ~/.a2wave/workspaces is always allowed. docker-compose.yml defaults this
# to /data/workspace, matching the bind mount above. Add other dedicated worktree volumes here.
SCM_WORKSPACES_ALLOWED_ROOTS=

# UID/GID the container runs as. Left empty, the entrypoint adapts to the owner of the
# mounted ~/.claude directory (Linux).
# On macOS Docker Desktop (VirtioFS) mounts are reported as root:root, so adaptive inference
# refuses to start and these must be set explicitly to the image defaults 10001 / 10001.
A2WAVE_RUN_AS_UID=
A2WAVE_RUN_AS_GID=

# ========================
# P4 code source (created automatically once all fields are filled)
# ========================

# Perforce native protocol, not HTTP. Plaintext: host:1666, SSL: ssl:host:1666
SCM_P4_PORT=
SCM_P4_USER=
SCM_P4_PASSWD=
SCM_P4_CLIENT=
SCM_P4_DEPOT_PATH=

# ========================
# Git code source (created automatically once the URL is filled)
# ========================

SCM_GIT_REPO_URL=
SCM_GIT_BRANCH=main
SCM_GIT_USERNAME=
SCM_GIT_PAT=

# ========================
# Settings overrides (optional)
# ========================

SETTINGS_GENERAL_WORKSPACE_PATH=
SETTINGS_GENERAL_TIMEOUT_MINUTES=
SETTINGS_GENERAL_TEAM_NAME=
SETTINGS_BRANDING_SUBTITLE=
SETTINGS_BRANDING_FAVICON_URL=

# ========================
# Standard OIDC login (optional) — authorization code + PKCE, server-driven
# ========================
# Once ISSUER + CLIENT_ID are set, the login page shows a "Sign in with OIDC" button
# (which goes to /api/auth/oidc/login).
# Endpoints and signing keys are discovered automatically via
# {issuer}/.well-known/openid-configuration, and keys rotate through JWKS — nothing to paste by hand.
#
# This same config also backs the OAuth publish channel: Agents with publishAuthType='oauth'
# verify the caller's `Authorization: Bearer <jwt>` against this issuer's JWKS, so the channel
# is unavailable until OIDC and the current effective OIDC channel audience configuration are
# non-empty. Settings takes precedence; the environment variable is only a fallback when no valid
# Settings OIDC configuration exists.
# The channel deliberately ignores the OIDC *login* toggle: turning the sign-in button off (to
# force password-only login, or after switching to SAML) must not 503 every published integration.

# IdP issuer (one of the required pair. Example: https://login.example.com/realms/acme)
A2WAVE_OIDC_ISSUER=

# client_id registered at the IdP (one of the required pair)
A2WAVE_OIDC_CLIENT_ID=

# client_secret (optional; when omitted the client is treated as a PKCE public client and the
# token endpoint is called without client credentials)
A2WAVE_OIDC_CLIENT_SECRET=

# Requested scopes (optional; defaults to "openid profile email")
A2WAVE_OIDC_SCOPES=

# Environment fallback for audiences accepted on the OAuth publish channel (optional;
# comma-separated). Settings takes precedence when it contains a valid OIDC configuration.
#
# Login always requires aud == CLIENT_ID. The channel cannot: a caller integrating its own
# service holds no a2wave login id_token. List instead the audience your IdP mints FOR a2wave.
#
# For a JWT access token `aud` names the TARGET RESOURCE SERVER -- this service -- and the
# resource server must confirm it is in that audience (RFC 9068 section 3). So the right value
# is an a2wave resource/API identifier (e.g. https://a2wave.example.com), which each caller
# requests via the IdP's resource/audience parameter. Do NOT list other applications'
# audiences: such a token was never issued for a2wave, and accepting it makes this channel a
# confused deputy for that service's tokens. Per-caller separation comes from oauthAccessMode
# and the email allowlist, not from aud.
#
# CLIENT_ID is NOT accepted implicitly -- list it explicitly if you intend to call with
# a2wave's own login tokens.
#
# When the environment is the active fallback, leaving this empty disables the channel entirely
# (fail closed) -- it never means "accept all".
# Never "open it up" by disabling the check: without an allowlist, any token the IdP ever signed
# for any relying party could invoke your Agents, and oauthAccessMode=all_idaas_users has no
# second gate behind it.
A2WAVE_OIDC_CHANNEL_AUDIENCES=

# ========================
# SAML 2.0 login (optional) — this server acts as the SP, server-driven
# ========================
# Once IDP_ENTRY_POINT + IDP_CERT are set, the login page shows a "Sign in with SAML" button
# (which goes to /api/auth/saml/login).
# The SP metadata endpoint GET /api/auth/saml/metadata can be registered directly at the IdP.

# The IdP's SSO entry URL (HTTP-Redirect binding address)
A2WAVE_SAML_IDP_ENTRY_POINT=

# IdP signing certificate (PEM, or the base64 body with the header/footer lines removed)
A2WAVE_SAML_IDP_CERT=

# SP entityId (optional; defaults to {service address}/api/auth/saml/metadata)
A2WAVE_SAML_SP_ENTITY_ID=
