{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignore": [
      ".claude/**",
      "test-results/**",
      "node_modules/**",
      "dist/**",
      "coverage/**",
      "data/**",
      "temp/**",
      "**/.understand-anything/**",
      "**/reports/mutation/**",
      "apps/api/drizzle/meta/**",
      "apps/api/drizzle-pg/meta/**",
      "apps/cli/src/generated/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "warn"
      },
      "performance": {
        "noDelete": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "a11y": {
        "noLabelWithoutControl": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "useFocusableInteractive": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
