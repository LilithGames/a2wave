{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "**",
      "!!**/.claude",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!**/data",
      "!!**/temp",
      "!!**/.understand-anything",
      "!!**/reports/mutation",
      "!!**/apps/api/drizzle/meta",
      "!!**/apps/api/drizzle-pg/meta",
      "!!**/apps/cli/src/generated"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "warn"
      },
      "performance": {
        "noDelete": "warn"
      },
      "correctness": {
        "noUnsafeOptionalChaining": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "a11y": {
        "noLabelWithoutControl": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "useFocusableInteractive": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "expand": "auto"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
