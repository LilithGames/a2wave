# Server
PORT=3502
HOST=0.0.0.0

# Database
# Default: a SQLite file path — zero external dependencies, the right choice for
# single-node deployments and local development.
DATABASE_URL=./data/a2wave.db
# PostgreSQL (>= 9.6) is EXPERIMENTAL — not yet recommended for production, no
# production soak time, and there is NO SQLite -> PostgreSQL data migration path
# (switching starts from an empty database). See docs/agent/postgresql.md.
# It is opted into purely by the URL scheme; there is no separate driver switch
# that could drift out of sync with it. To run the bundled server:
#   docker compose --profile postgres up -d
# DATABASE_URL=postgres://a2wave:a2wave@localhost:5432/a2wave
# Max PostgreSQL pool connections (ignored on SQLite).
DATABASE_POOL_MAX=10

# CORS
CORS_ORIGIN=http://localhost:3501

# Auth
# Leave empty: `pnpm dev` generates a secret into this file on first start.
# A placeholder value here would count as "already set" and suppress that, then
# fail production startup, which requires at least 32 characters.
# For Docker/production, generate one yourself: `openssl rand -hex 32`.
AUTH_SECRET=
# 浏览器 cookie 和登录签发的 bearer token 有效期（天），默认 7 天（一个工作周），范围 1~365。
# 不是 CLI 令牌的有效期——那个在创建每个令牌时单独选。
# 变更只影响新登录/新签发 token；如需立即收紧旧 token，请配合登出、改密或 tokenVersion 撤销。
AUTH_SESSION_TTL_DAYS=7

# --- Cursor Agent Engine ---
# cursor-agent CLI 的 API Key（可选，建议在 Agent 详情的环境变量中按 Agent 单独配置）
CURSOR_API_KEY=
# 执行超时（分钟），默认 10
CURSOR_AGENT_TIMEOUT_MINUTES=10
# 是否启用 --force 模式（跳过确认），默认 false
CURSOR_AGENT_FORCE=false
# 是否自动批准 MCP 工具调用，默认 true
CURSOR_AGENT_APPROVE_MCPS=true
# Agent 默认工作目录（沙箱路径）
CURSOR_AGENT_WORK_DIR=./data/workspaces

# --- Claude Code Engine ---
# claude 可执行文件路径
CLAUDE_CODE_PATH=claude
# 执行超时（分钟），默认 10
CLAUDE_CODE_TIMEOUT_MINUTES=10
# 是否启用 --dangerously-skip-permissions 模式，默认 true
CLAUDE_CODE_FORCE=false
# 是否自动批准 MCP 工具调用（通过 --allowedTools mcp__* 放行），默认 true
CLAUDE_CODE_APPROVE_MCPS=true
# Agent 默认工作目录（沙箱路径）
CLAUDE_CODE_WORK_DIR=/tmp/a2wave-sandbox

# --- OpenCode Engine ---
# opencode 可执行文件路径（默认 opencode，安装在 ~/.opencode/bin 时需填绝对路径）
OPENCODE_PATH=opencode
# 执行超时（分钟），默认 10
OPENCODE_TIMEOUT_MINUTES=10
# Agent 默认工作目录
OPENCODE_WORK_DIR=./data/workspaces

# --- Qoder Engine ---
# Path to the qodercli executable (minimum version 1.0.0)
QODER_PATH=qodercli
# Deployment-level default Personal Access Token (generated at qoder.com/account/integrations; per-agent config takes precedence)
QODER_PERSONAL_ACCESS_TOKEN=
# Execution timeout (minutes), default 10
QODER_TIMEOUT_MINUTES=10
# Whether to enable --dangerously-skip-permissions ("ask" permissions are auto-denied in headless mode), default false
QODER_FORCE=false
# Whether to auto-approve MCP tool calls (allowed via --allowed-tools mcp__*), default true
QODER_APPROVE_MCPS=true
# Default working directory for Agents
QODER_WORK_DIR=./data/workspaces

# --- Trae Engine ---
# Path to the traecli executable (minimum version 0.120.0; only available to TRAE CN enterprise Ultimate accounts)
TRAE_PATH=traecli
# Deployment-level default CLI login token (generated in the enterprise console, trae-lt-...; per-agent config takes precedence)
TRAECLI_PERSONAL_ACCESS_TOKEN=
# Enterprise-dedicated domain (optional)
TRAECLI_HOST=
# Execution timeout (minutes), default 10
TRAE_TIMEOUT_MINUTES=10
# Whether to enable -y/--yolo to skip tool permission checks, default false
TRAE_FORCE=false
# Whether to auto-approve MCP tool calls (allowed via --allowed-tool mcp__*), default true
TRAE_APPROVE_MCPS=true
# Default working directory for Agents
TRAE_WORK_DIR=./data/workspaces

# --- Kimi Code Engine ---
# Path to the kimi executable (@moonshot-ai/kimi-code, minimum version 0.30.0)
KIMI_PATH=kimi
# Execution timeout (minutes), default 10
KIMI_TIMEOUT_MINUTES=10
# Default working directory for Agents
KIMI_WORK_DIR=./data/workspaces
# No credential variable: Kimi authenticates via the `kimi login` device-code flow
# (credentials under ~/.kimi-code) and deliberately does not read API keys from the
# environment, so localSession is its only auth mode. No FORCE/APPROVE_MCPS either —
# `kimi -p` rejects --yolo/--auto/--plan and always runs the `auto` permission policy.

# --- Pi Engine ---
# Path to the pi executable (@earendil-works/pi-coding-agent, minimum version 0.83.0)
PI_PATH=pi
# Execution timeout (minutes), default 10
PI_TIMEOUT_MINUTES=10
# Default working directory for Agents
PI_WORK_DIR=./data/workspaces
# Optional deployment-level Pi config/auth directory. Leave empty for ~/.pi/agent.
PI_CODING_AGENT_DIR=
# Pi uses its configured local credentials (`pi`, then `/login`) and supports many
# underlying providers, so localSession is the only a2wave auth mode. Pi has no
# built-in MCP client; a2wave therefore does not deliver MCP servers to it.

# --- Skills Storage ---
# Skill 文件存储路径（相对于项目根或绝对路径），默认 ./data/skills
A2WAVE_SKILLS_STORAGE=./data/skills

# --- Log rotation (production) ---
# 日志文件路径，默认 ./data/logs/current.log；单文件 20MB，最多 10 个
LOG_FILE_PATH=./data/logs/current.log
# 生产环境是否启用日志轮转，默认 true
LOG_ROTATE_ENABLED=true

# --- Docker / 环境变量注入（零交互部署）---
# 管理员初始密码（首次启动时自动设置，之后不再覆盖）
ADMIN_PASSWORD=

# P4 代码源（全部设置则自动创建 name=env:p4）
SCM_P4_PORT=          # Perforce 原生协议，非 HTTP。明文: host:1666，SSL: ssl:host:1666
SCM_P4_USER=
SCM_P4_PASSWD=
SCM_P4_CLIENT=
SCM_P4_DEPOT_PATH=
SCM_P4_LOCAL_PATH=/app/data/p4-workspace
SCM_P4_AUTO_SYNC=true
SCM_P4_SYNC_INTERVAL=30

# Git 代码源（SCM_GIT_REPO_URL 设置则自动创建 name=env:git）
SCM_GIT_REPO_URL=
SCM_GIT_BRANCH=main
SCM_GIT_USERNAME=
SCM_GIT_PAT=
SCM_GIT_LOCAL_PATH=/app/data/git-workspace
SCM_GIT_AUTO_SYNC=true
SCM_GIT_SYNC_INTERVAL=30

# Settings 覆盖（SETTINGS_<CATEGORY>_<KEY> 映射到 category.key）
SETTINGS_GENERAL_WORKSPACE_PATH=
SETTINGS_GENERAL_TIMEOUT_MINUTES=
SETTINGS_GENERAL_TEAM_NAME=
SETTINGS_BRANDING_SUBTITLE=
SETTINGS_BRANDING_FAVICON_URL=

# Private-DNS allowlist for Provider Base URLs (exact comma-separated hostnames; no scheme, port, path, or wildcard).
# Trust covers HTTP(S) ports and paths, but not loopback, link-local/metadata, or other forbidden ranges.
# Claude OAuth/server-session discovery trusts only its fixed api.anthropic.com request;
# user-configured Provider Base URLs on that hostname still require this allowlist.
TRUSTED_PROVIDER_HOSTS=

# Network proxy (optional): applies when KB Notion sync reaches api.notion.com
# HTTPS_PROXY=
