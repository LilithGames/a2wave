{
  "name": "@a2wave/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts && tsup src/mcp-servers/a2wave-agent-router.ts src/mcp-servers/a2wave-platform-admin.ts src/mcp-servers/a2wave-mcp-group-proxy.ts --format esm --no-splitting --outDir dist/mcp-servers --platform node && tsup src/scripts/set-admin-password.ts --format esm --no-splitting --outDir dist/scripts --platform node && cp -r src/builtin-skills dist/builtin-skills",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "tsx scripts/generate-pg-schema.ts",
    "db:generate:pg:migration": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:smoke": "stryker run --concurrency 1 --maxTestRunnerReuse 0",
    "a2a-demo": "tsx scripts/a2a-demo.ts",
    "bench:finish-run": "tsx scripts/bench-finish-run-success.ts",
    "reset-admin": "tsx src/scripts/reset-admin.ts",
    "set-admin-password": "tsx src/scripts/set-admin-password.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@a2wave/shared": "workspace:*",
    "@hono/node-server": "^2.0.5",
    "@hono/swagger-ui": "^0.6.1",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@node-rs/argon2": "^2.0.2",
    "@node-saml/node-saml": "^5.1.0",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "@types/ws": "^8.5.13",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1",
    "cross-spawn": "7.0.6",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "hono": "~4.13.1",
    "ipaddr.js": "^2.4.0",
    "jose": "^5.9.6",
    "marked": "^18.0.5",
    "mustache": "^4.2.0",
    "openid-client": "^6.8.4",
    "pg": "^8",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "sanitize-html": "^2.17.5",
    "undici": "^7.29.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cross-spawn": "6.0.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.4",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.4"
  }
}
