# Generated by drizzle-kit — every migration emits a full-schema snapshot
# (thousands of lines) even for a one-line DDL change. Collapse them in diffs
# and keep them out of language stats; they are still tracked and reviewable.
apps/api/drizzle/meta/** linguist-generated=true
apps/api/drizzle-pg/meta/** linguist-generated=true

# Generated from the SQLite schema by `pnpm db:generate:pg` — never hand-edited.
apps/api/src/db/schema.pg.ts linguist-generated=true
